# Copy this file to .env and fill in your values.
# The app runs with the defaults below, but you MUST set the admin credentials.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Use a long, random string in production. Admin sessions are signed with this.
JWT_SECRET=dev-secret-change-in-production

# Default admin account (used by seed and reset scripts)
ADMIN_EMAIL=admin@3ssaree.com
ADMIN_PASSWORD=YourStrongPassword
ADMIN_NAME=Admin

# AI Chat API key (optional — chat falls back to WhatsApp without it)
# Supports both providers (auto-detected by key prefix):
#   Groq (free tier): get key at https://console.groq.com (starts with gsk_)
#   xAI/Grok: get key at https://console.x.ai (starts with xai-)
GROK_API_KEY=

# Optional: override the AI model (default: auto-selected per provider)
# Groq models: qwen/qwen3.8-27b, openai/gpt-oss-120b, allam-2-7b
# xAI models: grok-3-mini-fast
# AI_MODEL=
